#!/usr/bin/env bash
# Usage: tools/api GET /api/states  |  tools/api POST /api/services/light/turn_on '{"entity_id":"..."}'
cd "$(dirname "$0")/.." || exit 1
T=$(cat .secrets/ha_token 2>/dev/null || cat .secrets/.short_at)
M=$1; P=$2; shift 2
curl -s -X "$M" "http://localhost:8123$P" -H "Authorization: Bearer $T" -H 'Content-Type: application/json' ${1:+-d "$1"}
